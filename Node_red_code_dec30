        "id": "586459309f67b7ba",
        "type": "function",
        "z": "407901e793da6dec",
        "name": "Activate Irrigation",
        "func": "// --- Existing variables ---\nlet weightDifference = flow.get('weightDifference');\nlet measuredValue = flow.get('LoadCellMedian');\nlet maxWeight = flow.get('maxWeight');\nlet solenoid = flow.get('solenoid') || 0;\n\n  node.warn(`💧 weight diff=${weightDifference}, weight=${measuredValue}, max=${maxWeight}`);\n\nif (maxWeight === undefined || maxWeight === null || isNaN(maxWeight)) {\n    maxWeight = 981.2; // Default starting max weight in grams\n    flow.set('maxWeight', maxWeight);\n    node.warn(`⚙️ No stored maxWeight found. Default set to ${maxWeight} g`);\n}\n\n// --- Get current local hour ---\nlet now = new Date();\nlet currentHour = now.getHours(); // 0–23 in local time\n\n// --- Check time window (9AM–1PM) ---\nlet isWithinTime = (currentHour >= 9 && currentHour < 13);\n\n// --- Main logic ---\nif (isWithinTime) {\n\n    // Case 1: weight is below threshold → start watering\n    if (measuredValue < (maxWeight - weightDifference)) { \n        msg.payload = \"autoOn\";\n        node.status({ fill: \"green\", shape: \"dot\", text: \"Watering (autoOn)\" });\n        flow.set(\"solenoid\", 1);\n        node.warn(`💧 Watering started: currentHour=${currentHour}, weight=${measuredValue}`);\n     }\n\n} else {\n    // Outside allowed hours\n    msg.payload = \"autoOff\";\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"Outside watering hours\" });\n    node.warn(`⚠️ Not watering: current time ${currentHour}:00 is outside 9–13 window`);\n    \n}\n// --- Auto-refresh display even if no message sent ---\nif (solenoid === 1) {\n    node.status({ fill: \"green\", shape: \"dot\", text: \"Watering (autoOn)\" });\n} else if (solenoid === 0) {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"Irrigation OFF\" });\n}\n\nreturn msg;\n",
