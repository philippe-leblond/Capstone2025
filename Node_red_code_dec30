        "func": "// --- Get threshold values ---\nlet diff = flow.get(\"diffThreshold\");\nlet activeThreshold = flow.get(\"activeThreshold\");\n\n// --- Detect deploy/restart ---\nlet hasActivated = flow.get(\"hasActivated\") || false;\n\n// If the function node just restarted, mark startup time\nif (!flow.get(\"startupChecked\")) {\n    flow.set(\"startupChecked\", true);\n    node.warn(\"⚠️ System restarted — waiting for threshold activation\");\n}\n\n// --- Handle dashboard button input ---\nif (msg.topic === \"activate\") {\n    if (diff === undefined || diff === null) {\n        msg.payload = \"⚠️ No threshold set!\";\n        msg.color = \"red\";\n        flow.set(\"hasActivated\", false);\n    } else {\n        flow.set(\"activeThreshold\", diff);\n        flow.set(\"hasActivated\", true);\n        msg.payload = `✅ Threshold activated: ${diff}`;\n        msg.color = \"green\";\n    }\n}\n// --- On regular updates (not activation) ---\nelse {\n    // If system restarted or never activated since deploy\n    if (!hasActivated) {\n        msg.payload = \"⚠️ Threshold not activated since last deploy!\";\n        msg.color = \"red\";\n    } else {\n        msg.payload = `✅ Active threshold: ${activeThreshold}`;\n        msg.color = \"green\";\n    }\n}\n\nreturn msg;\n",
