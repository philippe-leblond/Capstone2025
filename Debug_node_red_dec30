    {
        "id": "759e8f93695610b4",
        "type": "function",
        "z": "58ee3731341e81a1",
        "name": "Get Median Load Cell Value",
        "func": "// Get the payload from the previous node (array of all data)\nlet data = msg.payload;\n\n// Extract weight1, weight2, weight3 (indexes 3, 4, 5)\nlet values = [data[3], data[4], data[5]];\n\n// Sort the values in ascending order\nvalues.sort((a, b) => a - b);\n\n// Compute the median (middle value after sorting)\nlet median;\nif (values.length === 3) {\n    median = values[1]; // middle element of 3 values\n} else {\n    // Just in case there’s a different number of values\n    let mid = Math.floor(values.length / 2);\n    median = values.length % 2 !== 0\n        ? values[mid]\n        : (values[mid - 1] + values[mid]) / 2;\n}\n\n// Output median value\nmsg.payload = median;\nmsg.topic = \"LoadCellMedian\";\nflow.set(\"LoadCellMedian\", median);\nreturn msg;\n",
