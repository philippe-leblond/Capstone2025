        "name": "Max Values Weight ",
        "func": "// Get saved state from context\nlet active = context.get(\"active\") || false;\nlet timer = context.get(\"timer\");\n\n// Handle solenoid trigger\nif (msg.topic === \"solenoidState\" && msg.payload === \"trigger\") {\n    node.warn(\"Trigger received: will store latest median in 10 minutes.\");\n\n    // If already active, reset the timer\n    if (timer) clearTimeout(timer);\n\n    // Start timer (e.g. 15 seconds for testing)\n    timer = setTimeout(() => {\n        // ⬇️ Get the *latest* value from flow at the end of the timer\n        let latestMaxWeight = flow.get(\"LoadCellMedian\");\n\n        if (latestMaxWeight !== undefined && latestMaxWeight !== null && !isNaN(latestMaxWeight)) {\n            flow.set(\"maxWeight\", latestMaxWeight);\n            node.warn(`✅ Saved latest maxWeight: ${latestMaxWeight}`);\n            node.status({ fill: \"green\", shape: \"dot\", text: `Saved: ${latestMaxWeight}` });\n            \n            let dashboardMsg = {\n        topic: \"maxWeight\",\n        payload: latestMaxWeight\n    };\n    node.send(dashboardMsg); // send value out of the function\n        } else {\n            node.warn(\"⚠️ No valid LoadCellMedian found to save.\");\n            node.status({ fill: \"red\", shape: \"ring\", text: \"No valid LoadCellMedian\" });\n        }\n\n        context.set(\"active\", false);\n        context.set(\"timer\", null);\n    }, 10*60*1000); // ←(or 10*60*1000 for 10 minutes)\n\n    // Save timer reference\n    context.set(\"active\", true);\n    context.set(\"timer\", timer);\n    return null;\n}\n\n// Not doing anything otherwise\nreturn null;\n",
