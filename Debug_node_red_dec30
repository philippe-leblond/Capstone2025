    {
        "id": "c9b5369fdaf07115",
        "type": "function",
        "z": "58ee3731341e81a1",
        "name": "Turn Off Irrigation",
        "func": "let solenoidState = flow.get(\"solenoidState\");\nlet median = flow.get(\"LoadCellMedian\")\nlet solenoid = flow.get('solenoid') || 1;\n\n// --- Initialize persistent variables ---\nlet buffer = context.get(\"buffer\") || [];        // Rolling 60-element buffer\nlet avgHistory = context.get(\"avgHistory\") || []; // Store averages for trend check\nlet prevSolenoid = context.get(\"prevSolenoid\");\n\n// --- Reset logic: when solenoid goes from ON to OFF ---\nif (prevSolenoid === 1 && solenoidState === 0) {\n    buffer = [];\n    avgHistory = [];\n    node.status({ fill: \"grey\", shape: \"dot\", text: \"Reset buffer (solenoid OFF)\" });\n    node.warn(\"🧹 Solenoid OFF → buffer reset\");\n}\n\n// --- Only process when solenoid is ON ---\nif (msg.topic === \"LoadCellMedian\" && solenoidState === 1 && typeof msg.payload === \"number\" && !isNaN(median)) {\n\n    // Add new median value to buffer\n    buffer.push(median);\n    if (buffer.length > 60) buffer.shift(); // maintain rolling window of 60 elements\n\n    // Only compute average if buffer is full (60 samples)\n    if (buffer.length === 60) {\n        let avg = buffer.reduce((a, b) => a + b, 0) / buffer.length;\n        avgHistory.push(avg);\n        if (avgHistory.length > 2) avgHistory.shift(); // Keep only last 2 averages\n\n        // Check if we have two averages to compare\n        if (avgHistory.length === 2) {\n            let diff = Math.abs(avgHistory[1] - avgHistory[0]);\n            node.status({ fill: \"blue\", shape: \"ring\", text: `Δavg=${diff.toFixed(2)}g` });\n\n            // If difference < 3g → stop watering\n            if (diff < 3) {\n                msg.payload = \"autoOff\";\n                msg.topic = \"greenhouse/control\";\n                node.status({ fill: \"red\", shape: \"dot\", text: \"AutoOff (Δ<3g)\" });\n                node.warn(`🛑 AutoOff triggered — avg change < 3g (${diff.toFixed(2)}g)`);\n                flow.set(\"solenoid\", 0);\n            } else {\n                // Otherwise, keep running (no output)\n                msg = null;\n            }\n        } else {\n            // Not enough averages yet\n            msg = null;\n        }\n    } else {\n        node.status({ fill: \"green\", shape: \"dot\", text: `Buffer: ${buffer.length}/60` });\n        msg = null;\n    }\n} else {\n    msg = null; // Solenoid OFF → ignore readings\n}\n\n// --- Save state ---\ncontext.set(\"buffer\", buffer);\ncontext.set(\"avgHistory\", avgHistory);\ncontext.set(\"prevSolenoid\", solenoidState);\n\nreturn msg;\n",
