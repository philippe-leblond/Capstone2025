        "name": "Solenoid State",
        "func": "// Get previous solenoid value from node context\nlet prev = context.get('prev');\nlet current = msg.payload;\n\n// Default previous value if not set yet\nif (prev === undefined) {\n    context.set('prev', current);\n    return null; // skip first message\n}\n\n// Detect falling edge: 1 → 0\nif (prev === 1 && current === 0) {\n    node.warn(\"Solenoid changed from 1 → 0\");\n    msg.topic = \"solenoidState\";\n    msg.payload = \"trigger\";\n    context.set('prev', current);\n    return msg; // output the trigger message\n}\n\n// Update stored value for next comparison\ncontext.set('prev', current);\nflow.set('solenoidState', current);\nreturn null; // no change, so no output",
