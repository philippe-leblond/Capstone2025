        "type": "function",
        "z": "58ee3731341e81a1",
        "name": "Max Values Weight ",
        "func": "// Get saved state from context\nlet active = context.get(\"active\") || false;\nlet timer = context.get(\"timer\");\nlet maxWeight = context.get(\"maxWeight\");\n\n// Handle solenoid trigger\nif (msg.topic === \"solenoidState\" && msg.payload === \"trigger\") {\n    node.warn(\"Trigger received: will store median data for 10 minutes.\");\n\n    // If already active, reset the timer\n    if (timer) clearTimeout(timer);\n\n    // Start a 10-minute window (600,000 ms)\n    timer = setTimeout(() => {\n        node.warn(\"10 minutes elapsed — storing last median value.\");\n        let latestWeight = flow.get(\"maxWeight\"); // get freshest data\n        let output = {\n            topic: \"SavedMaxWeight\",\n            payload: latestWeight\n         //   payload: maxWeight\n        };\n        node.send(output); // send the saved value\n        context.set(\"active\", false);\n        context.set(\"timer\", null);\n    // }, 10 * 60 * 1000);\n    }, 5000);\n\n    // Update context\n    context.set(\"active\", true);\n    context.set(\"timer\", timer);\n    return null; // don’t output yet\n}\n\n// If receiving median values\n//if (msg.topic === \"LoadCellMedian\" && active) {\n//    maxWeight = msg.payload;\n //   context.set(\"maxWeight\", maxWeight);\n    flow.set(\"maxWeight\", maxWeight);\n //   node.status({fill:\"green\", shape:\"dot\", text:\"Recording median\"});\n//}\n\n// Not doing anything otherwise\nreturn null;\n",
